POSTGRES_USER=viewer_rewards
POSTGRES_PASSWORD=change_me
POSTGRES_DB=viewer_rewards
DATABASE_URL=postgresql://viewer_rewards:change_me@postgres:5432/viewer_rewards

REDIS_URL=redis://redis:6379

JWT_SECRET=change_me

# Origines autorisées pour la poignée de main WebSocket (liste séparée
# par des virgules). Vide, aucune origine tierce n'est acceptée.
CORS_ORIGINS=http://localhost:3000

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Production uniquement (docker-compose.prod.yml) : domaines et email
# pour le certificat Let's Encrypt via Traefik.
FRONTEND_DOMAIN=viewer-rewards.example.com
BACKEND_DOMAIN=api.viewer-rewards.example.com
ACME_EMAIL=admin@example.com
