POSTGRES_USER=viewer_rewards
POSTGRES_PASSWORD=change_me
POSTGRES_DB=viewer_rewards
DATABASE_URL=postgresql://viewer_rewards:change_me@postgres:5432/viewer_rewards

REDIS_URL=redis://redis:6379

JWT_SECRET=change_me

# Origines autorisées pour le CORS HTTP et la poignée de main WebSocket
# (liste séparée par des virgules, origines exactes avec schéma et port).
# Vide, aucune origine tierce n'est acceptée.
CORS_ORIGINS=http://localhost:3000

# Attribut Secure du cookie de session, actif par défaut. Seul
# docker-compose.override.yml (développement local, sans TLS) le
# désactive : ne jamais mettre false ici.
COOKIE_SECURE=true

# URL de base de l'API, appelée directement depuis le navigateur : elle
# doit être joignable depuis le poste du visiteur, pas depuis le réseau
# Docker. En développement local, le backend est publié sur le port 3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Production uniquement (docker-compose.prod.yml) : domaines et email
# pour le certificat Let's Encrypt via Traefik.
FRONTEND_DOMAIN=viewer-rewards.example.com
BACKEND_DOMAIN=api.viewer-rewards.example.com
ACME_EMAIL=admin@example.com
