DATABASE_URL="postgresql://viewer_rewards:change_me@localhost:5432/viewer_rewards?schema=public"
JWT_SECRET=change_me
PORT=3000

# Redis (file BullMQ du worker : job planifié de tirage au sort, et
# canal pub/sub par lequel le worker fait diffuser ses notifications
# temps réel via la Gateway WebSocket)
REDIS_URL=redis://localhost:6379

# Origines autorisées pour la poignée de main WebSocket (liste séparée
# par des virgules). Vide, aucune origine tierce n'est acceptée.
CORS_ORIGINS=http://localhost:3000
