DATABASE_URL="postgresql://skuup:change_me@localhost:5432/skuup?schema=public"
JWT_SECRET=change_me
PORT=3000

# Redis (file BullMQ du worker : job planifié de tirage au sort, et
# canal pub/sub par lequel le worker fait diffuser ses notifications
# temps réel via la Gateway WebSocket)
REDIS_URL=redis://localhost:6379

# Origines autorisées pour le CORS HTTP et la poignée de main WebSocket
# (liste séparée par des virgules, origines exactes avec schéma et port).
# Vide, aucune origine tierce n'est acceptée.
CORS_ORIGINS=http://localhost:3000

# Attribut Secure du cookie de session. Le développement local sert tout
# en HTTP simple, un cookie Secure y serait rejeté par le navigateur.
# Ne jamais passer à false hors développement local : toute autre valeur
# (ou l'absence de variable) laisse l'attribut activé.
COOKIE_SECURE=false
